# Go backend environment variable NAMES only. Copy to backend/.env (gitignored) and fill in.
# Secrets (database URLs, Storage service key) live only here, never in the Next.js app (Codex R21).

# --- Go API (cmd/api) ---
# Listen address; defaults to :8080.
API_ADDR=
# Postgres connection as the dedicated role saa_api, e.g. postgres://saa_api:<password>@127.0.0.1:54322/postgres
DATABASE_URL=
# Supabase project API URL, e.g. http://127.0.0.1:54321 (JWT issuer = ${SUPABASE_URL}/auth/v1).
SUPABASE_URL=
# Optional JWKS override; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Comma list of exact browser origins allowed by CORS, e.g. http://localhost:3000
FRONTEND_ORIGINS=
# Comma list of emails that get role admin when they sign in (G02).
ADMIN_EMAILS=
# Optional until the upload phase; Storage service key used by Go for kudo uploads (local: SECRET_KEY from `supabase status -o env`).
SUPABASE_SERVICE_KEY=

# --- Local tooling only (seed runner, integration tests, dev-db-role.sql) ---
# Local `postgres` owner connection, loopback host only, e.g. postgres://postgres:<password>@127.0.0.1:54322/postgres
LOCAL_OWNER_DATABASE_URL=
# prelaunch | live (default) | after-ceremony
SEED_SCENARIO=
# Login password given to saa_api by backend/scripts/dev-db-role.sql (16+ characters).
SAA_API_DB_PASSWORD=
