# Supabase CLI environment variable NAMES only (substituted into config.toml via env()).
# Copy to supabase/.env (gitignored) and fill in the Google OAuth client for local sign-in.
# Authorized redirect URI in Google Cloud: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
