# Frontend environment variable NAMES only. Copy to .env.local and fill in values.
# Only the Supabase publishable key belongs here; never a service/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Go API base URL as seen from the browser (includes scheme + host, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=
# Go API base URL as seen from the Next.js server (may differ inside Docker/hosting)
API_BASE_URL=
